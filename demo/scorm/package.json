{
  "name": "scorm-monorepo",
  "version": "1.0.0",
  "description": "A monorepo for SCORM project with Vue 3 frontend and Express backend",
  "main": "index.js",
  "scripts": {
    "dev:front": "pnpm --filter frontend dev",
    "dev:back": "pnpm --filter backend dev",
    "build:front": "pnpm --filter frontend build",
    "build:back": "pnpm --filter backend build",
    "dev": "pnpm -r dev",
    "build": "pnpm -r build"
  },
  "keywords": [
    "monorepo",
    "vue3",
    "express",
    "pnpm"
  ],
