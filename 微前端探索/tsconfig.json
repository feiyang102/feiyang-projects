{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "jsx": "preserve",
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@admin/core": ["packages/core/src/index.ts"],
      "@admin/ui": ["packages/ui/src/index.ts"],
      "@admin/auth": ["packages/auth/src/index.ts"],
      "@admin/micro": ["packages/micro/src/index.ts"],
      "@admin/bridge": ["packages/bridge/src/index.ts"]
    }
  },
  "include": ["packages/*/src/**/*.ts", "packages/*/src/**/*.vue", "examples/*/src/**/*.ts", "examples/*/src/**/*.vue"],
  "exclude": ["node_modules", "dist"]
}
