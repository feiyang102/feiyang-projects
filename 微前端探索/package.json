{
  "name": "admin-framework",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" build",
    "dev": "pnpm --filter playground dev",
    "dev:sub": "pnpm --filter remote-order dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "check:deps": "node scripts/check-deps.mjs",
    "check:versions": "node scripts/check-versions.mjs",
    "lint": "pnpm check:deps && pnpm check:versions",
    "pack:all": "pnpm -r --filter \"./packages/*\" exec pnpm pack"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^25.0.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vite": "^7.0.0",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^3.0.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "vue-tsc": "^2.2.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "vue-demi"
    ]
  }
}
